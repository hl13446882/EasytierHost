{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EasyTierHost network profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["networkName", "secretFile", "role"],
  "properties": {
    "schemaVersion": { "const": 1, "default": 1 },
    "networkName": { "type": "string", "minLength": 1 },
    "secretFile": { "type": "string", "minLength": 1 },
    "role": { "enum": ["Seed", "Gateway", "Dedicated", "Client"] },
    "seedPhysicalIp": { "type": ["string", "null"], "format": "ipv4" },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 11010 },
    "rpcPort": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 15888 },
    "dedicatedIndex": { "type": ["integer", "null"], "minimum": 2, "maximum": 10 },
    "corePath": { "type": "string", "minLength": 1, "default": "easytier-core" },
    "cliPath": { "type": "string", "minLength": 1, "default": "easytier-cli" },
    "deviceName": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,32}$", "default": "easytierhost" },
    "enableInternetGateway": { "type": "boolean", "default": false, "description": "Reserved; preview refuses activation until underlay audit is complete." },
    "dnsUpstreams": { "type": "array", "items": { "type": "string", "format": "ipv4" } },
    "allowPublicDnsFallback": { "type": "boolean", "default": false }
  },
  "allOf": [
    { "if": { "properties": { "role": { "const": "Dedicated" } } }, "then": { "required": ["dedicatedIndex"], "properties": { "dedicatedIndex": { "type": "integer" } } }, "else": { "properties": { "dedicatedIndex": { "type": "null" } } } },
    { "if": { "properties": { "role": { "enum": ["Gateway", "Dedicated", "Client"] } } }, "then": { "required": ["seedPhysicalIp"], "properties": { "seedPhysicalIp": { "type": "string" } } } },
    { "if": { "properties": { "enableInternetGateway": { "const": true } }, "required": ["enableInternetGateway"] }, "then": { "properties": { "role": { "const": "Client" } } } }
  ]
}
